{
  "name": "form-detection-frontend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "features/*",
    "apps/*"
  ],
  "scripts": {
    "build:api-client": "npm run build -w packages/api-client",
    "build:shell-ports": "npm run build -w packages/shell-ports",
    "dev:web": "npm run dev -w @form-detection/web",
    "build:web": "npm run build -w @form-detection/web",
    "typecheck": "npm run build:api-client && npm run build:shell-ports && tsc --noEmit --project tsconfig.json",
    "test": "npm run typecheck && npm run test -w @form-detection/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^5.4.0"
  }
}
